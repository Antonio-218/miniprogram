.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.video-wrap {
  background: #000000;
}

.video {
  width: 100%;
  height: 420rpx;
  display: block;
}

.body {
  padding: 28rpx 24rpx 0;
}

.chapter-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1d26;
  line-height: 1.45;
}

.course-name {
  font-size: 24rpx;
  color: #8a90a2;
  margin-top: 10rpx;
}

.detail-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.detail {
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #3a4152;
  word-break: break-all;
}

.tip-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #9aa0b0;
}

.chapter-list {
  margin: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 63, 120, 0.06);
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.list-count {
  font-size: 24rpx;
  color: #8a90a2;
}

.chapter-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 2rpx solid #f2f4f8;
}

.num {
  width: 48rpx;
  font-size: 24rpx;
  color: #b4b9c7;
  flex-shrink: 0;
}

.chapter-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.name {
  font-size: 28rpx;
  color: #1a1d26;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state {
  font-size: 22rpx;
  color: #9aa0b0;
  margin-top: 6rpx;
}

.chapter-item.active .name {
  color: #2f6bff;
  font-weight: 600;
}

.chapter-item.active .state {
  color: #2f6bff;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2f6bff;
  margin-left: 16rpx;
}

.locked-wrap {
  padding: 200rpx 60rpx;
  text-align: center;
}

.locked-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1d26;
}

.locked-desc {
  font-size: 26rpx;
  color: #8a90a2;
  margin: 20rpx 0 48rpx;
}

.locked-btn {
  width: 320rpx;
  margin: 0 auto;
}
