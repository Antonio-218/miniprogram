<view class="page">
  <view class="profile">
    <button class="avatar-btn btn-reset" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-placeholder">{{nickInitial}}</view>
    </button>
    <view class="profile-info">
      <input
        class="nickname"
        type="nickname"
        value="{{user.nickName}}"
        placeholder="点击设置昵称"
        placeholder-class="nickname-placeholder"
        bindblur="onNickBlur"
        bindconfirm="onNickBlur"
      />
      <view class="profile-sub">
        <text class="role">{{isAdmin ? '管理员' : '学员'}}</text>
        <text class="dot">·</text>
        <text>已购 {{purchasedCount}} 门课程</text>
      </view>
    </view>
  </view>

  <view class="card menu">
    <view class="menu-item" bindtap="goMyCourses" hover-class="menu-hover">
      <text class="menu-text">我的课程</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goOrders" hover-class="menu-hover">
      <text class="menu-text">我的订单</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{isAdmin}}" bindtap="goAdmin" hover-class="menu-hover">
      <text class="menu-text">管理后台</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="tips">
    <view class="tips-title">说明</view>
    <view class="tips-text">· 头像与昵称仅用于展示，可随时修改</view>
    <view class="tips-text">· 已购课程支持无限次学习</view>
    <view class="tips-text">· 如有疑问请联系课程管理员</view>
  </view>

  <view class="footer">云课 · 知识付费演示小程序</view>
</view>
