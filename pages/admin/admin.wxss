.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.admin-tabs {
  display: flex;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.admin-tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: 28rpx;
  color: #5b6275;
  position: relative;
}

.admin-tab.active {
  color: #2f6bff;
  font-weight: 600;
}

.admin-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 6rpx;
  transform: translateX(-50%);
  width: 44rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #2f6bff;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx 0;
}

.toolbar-title {
  font-size: 26rpx;
  color: #8a90a2;
}

.add-btn {
  background: #2f6bff;
  color: #ffffff;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
}

.list {
  padding: 24rpx;
}

.course-item,
.order-item {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 63, 120, 0.06);
}

.course-row {
  display: flex;
}

.cover {
  width: 200rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #eef1f6;
}

.info {
  flex: 1;
  padding-left: 20rpx;
  min-width: 0;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1d26;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.sub {
  font-size: 22rpx;
  color: #8a90a2;
  margin-top: 8rpx;
}

.course-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  margin-top: 18rpx;
  border-top: 2rpx solid #f2f4f8;
}

.switch-box {
  display: flex;
  align-items: center;
}

.switch-box switch {
  transform: scale(0.8);
}

.switch-text {
  font-size: 22rpx;
  color: #8a90a2;
  margin-left: 4rpx;
}

.acts {
  display: flex;
  align-items: center;
}

.act {
  font-size: 24rpx;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  margin-left: 16rpx;
}

.act.ghost {
  color: #5b6275;
  background: #f2f4f8;
}

.act.primary {
  color: #ffffff;
  background: #2f6bff;
}

.section {
  margin-top: 8rpx;
  padding: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.link {
  font-size: 26rpx;
  color: #2f6bff;
}

.cate-list {
  display: flex;
  flex-wrap: wrap;
}

.cate-chip {
  display: flex;
  align-items: center;
  background: #eef4ff;
  color: #2f6bff;
  font-size: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
}

.cate-remove {
  margin-left: 10rpx;
  font-size: 26rpx;
  color: #7ea6ff;
}

.muted-text {
  font-size: 24rpx;
  color: #9aa0b0;
}

.tabs {
  display: flex;
  background: #ffffff;
  padding: 0 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #5b6275;
  position: relative;
}

.tab.active {
  color: #2f6bff;
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  transform: translateX(-50%);
  width: 32rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #2f6bff;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-user {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1d26;
}

.order-status {
  font-size: 24rpx;
  font-weight: 600;
}

.order-status.pending {
  color: #ff8f1f;
}

.order-status.paid {
  color: #1aa06d;
}

.order-status.cancelled {
  color: #9aa0b0;
}

.order-course {
  font-size: 26rpx;
  color: #3a4152;
  margin-top: 16rpx;
  line-height: 1.5;
}

.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.order-no {
  font-size: 22rpx;
  color: #9aa0b0;
}

.order-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1d26;
}

.order-time {
  font-size: 22rpx;
  color: #b4b9c7;
  margin-top: 8rpx;
}

.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 26rpx;
  color: #2f6bff;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.stats-card {
  width: 48%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 63, 120, 0.06);
  display: flex;
  flex-direction: column;
}

.stats-label {
  font-size: 24rpx;
  color: #8a90a2;
}

.stats-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #2f6bff;
  margin-top: 12rpx;
}

.top-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 2rpx solid #f2f4f8;
}

.top-rank {
  width: 44rpx;
  font-size: 26rpx;
  color: #b4b9c7;
}

.top-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.top-title {
  font-size: 26rpx;
  color: #1a1d26;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-count {
  font-size: 22rpx;
  color: #9aa0b0;
  margin-top: 6rpx;
}

.top-amount {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1d26;
}

.no-auth {
  padding: 220rpx 60rpx;
  text-align: center;
}

.no-auth-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1d26;
}

.no-auth-desc {
  font-size: 26rpx;
  color: #8a90a2;
  line-height: 1.7;
  margin-top: 20rpx;
}
