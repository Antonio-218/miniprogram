.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.cover {
  width: 100%;
  height: 420rpx;
  display: block;
  background: #e9edf5;
}

.main {
  padding: 0 24rpx;
  margin-top: -48rpx;
}

.info-card {
  padding: 28rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #1a1d26;
}

.meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.tag {
  font-size: 22rpx;
  color: #2f6bff;
  background: #eef4ff;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #8a90a2;
  margin-right: 20rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-top: 20rpx;
}

.price {
  font-size: 40rpx;
  color: #ff5722;
  font-weight: 700;
}

.origin {
  font-size: 24rpx;
  color: #b4b9c7;
  text-decoration: line-through;
  margin-left: 16rpx;
}

.owned {
  font-size: 22rpx;
  color: #1aa06d;
  background: #e9f8f1;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  margin-left: auto;
}

.block {
  margin-top: 24rpx;
  padding: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.count {
  font-size: 24rpx;
  color: #8a90a2;
}

.detail {
  font-size: 28rpx;
  line-height: 1.8;
  color: #3a4152;
  word-break: break-all;
}

.locked-hint {
  font-size: 26rpx;
  color: #9aa0b0;
  padding: 16rpx 0;
}

.chapter {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 2rpx solid #f2f4f8;
}

.chapter-index {
  width: 44rpx;
  font-size: 24rpx;
  color: #b4b9c7;
  flex-shrink: 0;
}

.chapter-title {
  flex: 1;
  font-size: 28rpx;
  color: #1a1d26;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lock {
  font-size: 22rpx;
  color: #b4b9c7;
  margin-left: 16rpx;
}

.play {
  font-size: 22rpx;
  color: #2f6bff;
  margin-left: 16rpx;
}

.share-row {
  margin-top: 32rpx;
  display: flex;
  justify-content: center;
}

.share-btn {
  font-size: 26rpx;
  color: #2f6bff;
  background: #eef4ff;
  padding: 16rpx 44rpx;
  border-radius: 999rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 24rpx rgba(31, 63, 120, 0.08);
}

.bottom-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.bottom-info .price {
  font-size: 36rpx;
}

.bottom-note {
  font-size: 22rpx;
  color: #9aa0b0;
  margin-top: 4rpx;
}

.buy-btn {
  width: 280rpx;
  height: 84rpx;
  line-height: 84rpx;
  background: #2f6bff;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 42rpx;
  padding: 0;
  margin: 0;
}

.buy-btn::after {
  border: none;
}

.buy-btn-hover {
  background: #1b4fd8;
}
