.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.form {
  margin: 24rpx;
  padding: 8rpx 28rpx;
}

.field {
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f2f4f8;
}

.field.no-border {
  border-bottom: none;
}

.field.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 28rpx;
  color: #1a1d26;
  font-weight: 500;
}

.field .label {
  display: block;
  margin-bottom: 16rpx;
}

.field.row .label {
  margin-bottom: 0;
}

.input {
  font-size: 28rpx;
  color: #1a1d26;
  height: 60rpx;
  width: 100%;
}

.input.right {
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
}

.textarea {
  width: 100%;
  height: 140rpx;
  font-size: 28rpx;
  color: #1a1d26;
  line-height: 1.6;
}

.cover-box {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f7fb;
  border: 2rpx dashed #d3dae8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-img {
  width: 100%;
  height: 300rpx;
  display: block;
}

.cover-empty {
  font-size: 26rpx;
  color: #9aa0b0;
}

.row-right {
  display: flex;
  align-items: center;
}

.picker-value {
  font-size: 28rpx;
  color: #5b6275;
  padding: 8rpx 0;
}

.mini-link {
  font-size: 26rpx;
  color: #2f6bff;
  padding: 8rpx 16rpx;
}

.mini-link.danger {
  color: #ff3b30;
}

.switch-text {
  font-size: 24rpx;
  color: #8a90a2;
  margin-left: 8rpx;
}

.editor {
  width: 100%;
  height: 400rpx;
  padding: 20rpx;
  background: #f9fafc;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1a1d26;
  box-sizing: border-box;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1d26;
}

.head-links {
  display: flex;
  align-items: center;
}

.head-links .mini-link {
  margin-left: 20rpx;
}

.chapter {
  padding: 24rpx 0;
  border-top: 2rpx solid #f2f4f8;
}

.chapter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.chapter-no {
  font-size: 26rpx;
  color: #2f6bff;
  font-weight: 600;
}

.remove {
  font-size: 24rpx;
  color: #ff3b30;
}

.chapter-input {
  margin-top: 16rpx;
  height: 76rpx;
  background: #f9fafc;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1a1d26;
}

.video-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.video-state {
  font-size: 24rpx;
  color: #8a90a2;
}

.video-acts {
  display: flex;
  align-items: center;
}

.muted-text {
  font-size: 24rpx;
  color: #9aa0b0;
  padding: 24rpx 0;
}

.footer {
  padding: 20rpx 40rpx 0;
}

.save-btn {
  width: 100%;
}

.footer-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b4b9c7;
}
