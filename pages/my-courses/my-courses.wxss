.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.header {
  padding: 32rpx 32rpx 8rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1d26;
}

.header-count {
  font-size: 24rpx;
  color: #8a90a2;
}

.list {
  padding: 24rpx;
}

.course-card {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 63, 120, 0.06);
}

.card-hover {
  opacity: 0.9;
}

.cover {
  width: 220rpx;
  height: 156rpx;
  flex-shrink: 0;
  background: #eef1f6;
}

.info {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1d26;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.sub {
  font-size: 22rpx;
  color: #9aa0b0;
  margin-top: 6rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.status {
  font-size: 22rpx;
  color: #1aa06d;
  background: #e9f8f1;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.enter {
  font-size: 24rpx;
  color: #2f6bff;
}

.empty-wrap {
  padding: 180rpx 60rpx;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #9aa0b0;
  margin-bottom: 40rpx;
}

.go-btn {
  width: 280rpx;
  margin: 0 auto;
}
