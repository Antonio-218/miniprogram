<view class="page">
  <view class="header">
    <text class="header-title">已购课程</text>
    <text class="header-count">共 {{list.length}} 门</text>
  </view>

  <view class="list" wx:if="{{list.length}}">
    <view
      class="course-card"
      wx:for="{{list}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="goStudy"
      hover-class="card-hover"
    >
      <image class="cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
      <view class="info">
        <view class="title">{{item.title}}</view>
        <view class="sub">{{item.chapterCount}} 节 · {{item.categoryName || '通用'}}</view>
        <view class="row">
          <text class="status">{{item.status === 'off' ? '已下架' : '学习中'}}</text>
          <text class="enter">继续学习 ›</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{loading}}" class="loading-tip">加载中...</view>

  <view wx:else class="empty-wrap">
    <view class="empty-text">还没有已购课程</view>
    <button class="btn-primary go-btn" bindtap="goHome">去逛逛</button>
  </view>
</view>
