<!-- 首页：搜索 + 分类筛选 + 课程列表 -->
<view class="page">
  <view class="header">
    <view class="header-top">
      <text class="brand">云课</text>
      <view class="header-links">
        <view class="link" bindtap="goMyCourses">我的课程</view>
        <view class="link" bindtap="goMine">我的</view>
      </view>
    </view>

    <view class="search">
      <input
        class="search-input"
        value="{{keyword}}"
        placeholder="搜索你想学的课程"
        placeholder-class="search-placeholder"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
      />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">×</text>
      <view class="search-btn" bindtap="onSearch">搜索</view>
    </view>
  </view>

  <scroll-view class="cates" scroll-x enable-flex show-scrollbar="{{false}}">
    <view
      class="cate {{activeCategory === '' ? 'active' : ''}}"
      data-id=""
      bindtap="onCategoryTap"
    >全部</view>
    <view
      class="cate {{activeCategory === item._id ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="onCategoryTap"
    >{{item.name}}</view>
  </scroll-view>

  <view class="list">
    <view
      class="course-card"
      wx:for="{{courses}}"
      wx:key="_id"
      data-id="{{item._id}}"
      bindtap="goDetail"
      hover-class="card-hover"
    >
      <image class="cover" src="{{item.cover}}" mode="aspectFill" lazy-load />
      <view class="info">
        <view class="title">{{item.title}}</view>
        <view class="tag-row">
          <text class="tag" wx:if="{{item.categoryName}}">{{item.categoryName}}</text>
          <text class="chapter-count" wx:if="{{item.chapterCount}}">{{item.chapterCount}} 节</text>
        </view>
        <view class="bottom">
          <text class="price">{{item.priceText}}</text>
          <text class="sales">已售 {{item.sales}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
    <view wx:elif="{{!courses.length}}" class="empty">暂无课程，换个关键词试试</view>
    <view wx:elif="{{noMore}}" class="loading-tip">没有更多课程了</view>
  </view>
</view>
