.page {
  min-height: 100vh;
  background: #f5f7fb;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.header {
  background: linear-gradient(135deg, #2f6bff 0%, #4f8bff 100%);
  padding: 24rpx 32rpx 40rpx;
  border-radius: 0 0 28rpx 28rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.header-links {
  display: flex;
  align-items: center;
}

.link {
  color: rgba(255, 255, 255, 0.95);
  font-size: 24rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  margin-left: 16rpx;
}

.search {
  margin-top: 26rpx;
  height: 80rpx;
  background: #ffffff;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 0 10rpx 0 28rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
  color: #1a1d26;
}

.search-placeholder {
  color: #b4b9c7;
}

.search-clear {
  color: #b4b9c7;
  font-size: 36rpx;
  padding: 0 12rpx;
  line-height: 1;
}

.search-btn {
  background: #2f6bff;
  color: #ffffff;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  line-height: 1;
}

.cates {
  white-space: nowrap;
  padding: 24rpx 24rpx 4rpx;
  display: flex;
  align-items: center;
}

.cate {
  display: inline-block;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #5b6275;
  background: #ffffff;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  margin-right: 16rpx;
  border: 2rpx solid transparent;
}

.cate.active {
  color: #2f6bff;
  background: #eef4ff;
  border-color: #cfe0ff;
  font-weight: 600;
}

.list {
  padding: 20rpx 24rpx 0;
}

.course-card {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 63, 120, 0.06);
}

.card-hover {
  opacity: 0.9;
}

.cover {
  width: 250rpx;
  height: 172rpx;
  flex-shrink: 0;
  background: #eef1f6;
}

.info {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1d26;
  line-height: 1.4;
  max-height: 84rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.tag-row {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}

.tag {
  font-size: 22rpx;
  color: #5b6275;
  background: #f2f4f8;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.chapter-count {
  font-size: 22rpx;
  color: #9aa0b0;
  margin-left: 12rpx;
}

.bottom {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 10rpx;
}

.price {
  font-size: 32rpx;
}

.sales {
  font-size: 22rpx;
  color: #9aa0b0;
}
